      "properties": {
        "invoice_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "title": "Invoice Id",
          "type": "string"
        }
      },
      "required": [
        "invoice_id"
      ],
      "title": "InvoiceArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
